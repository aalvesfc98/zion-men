generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Church {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  email     String   @unique
  phone     String?
  address   String?
  city      String?
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  members Member[]
  groups  Group[]
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  USER
}

model Member {
  id          String       @id @default(cuid())
  name        String
  email       String?
  phone       String?
  address     String?
  city        String?
  birthDate   DateTime?
  baptismDate DateTime?
  joinDate    DateTime     @default(now())
  status      MemberStatus @default(ACTIVE)
  notes       String?
  churchId    String
  church      Church       @relation(fields: [churchId], references: [id], onDelete: Cascade)
  groups      GroupMember[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  VISITOR
  DEACON
  ELDER
  PASTOR
}

model Group {
  id          String        @id @default(cuid())
  name        String
  description String?
  meetingDay  String?
  meetingTime String?
  location    String?
  churchId    String
  church      Church        @relation(fields: [churchId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model GroupMember {
  groupId  String
  memberId String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@id([groupId, memberId])
}
